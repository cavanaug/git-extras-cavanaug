#!/bin/bash
# git-colorize: Run any git command and colorize output based on common patterns.
#
# Usage:
#   git-colorize <git-command> [args...]
#   git colorize <git-command> [args...]
#
# Can also be used as a pipe filter:
#   some-command | git-colorize
#
# Color scheme:
#   Red    - errors, fatal messages, conflicts, failures, rejections
#   Yellow - warnings, hints, diverged branches
#   Cyan   - success/completion lines (up to date, already, done, etc.)
#   Normal - everything else

RED='\033[0;31m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

colorize_stream() {
    while IFS= read -r line; do
        if [[ $line =~ (^error:|^fatal:|conflict|CONFLICT|failed|rejected|cannot|not possible|refusing|aborting|Aborting) ]]; then
            echo -e "${RED}${line}${RESET}"
        elif [[ $line =~ (^warning:|^hint:|diverged|detached|ahead.*behind|behind.*ahead) ]]; then
            echo -e "${YELLOW}${line}${RESET}"
        elif [[ $line =~ (up to date|up-to-date|Already up|already exists|nothing to commit|Everything up-to-date|successfully|Successfully|done\.|Done\.) ]]; then
            echo -e "${CYAN}${line}${RESET}"
        else
            echo "$line"
        fi
    done
}

# If no arguments, act as a pipe filter
if [[ $# -eq 0 ]]; then
    colorize_stream
    exit $?
fi

# Otherwise run git with the given arguments and colorize output
git "$@" 2>&1 | colorize_stream
exit ${PIPESTATUS[0]}
