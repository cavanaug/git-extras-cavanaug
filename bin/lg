#!/bin/bash

# lg - Wrapper for lazygit with authentication caching

# Color constants
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Parse arguments
CACHE_ONLY=false
if [[ "$1" == "--cache-only" ]]; then
    CACHE_ONLY=true
    shift
fi

# Function to check if we're in a git repository
is_git_repo() {
    git rev-parse --git-dir >/dev/null 2>&1
}

# Function to cache authentication for current repo
cache_current_repo_auth() {
    # Skip if no remotes are configured
    if [[ -z "$(git remote)" ]]; then
        return 0
    fi
    echo -e "${BLUE}Caching authentication for current repository...${NC}"
    if git ls-remote >/dev/null 2>&1; then
        echo -e "${GREEN}✓ Authentication cached successfully${NC}"
    else
        echo -e "${RED}✗ Error: Could not cache authentication for current repo${NC}"
        exit 1
    fi
}

# Function to get lazygit config directory
get_lazygit_config_dir() {
    if [[ -n "$XDG_CONFIG_HOME" ]]; then
        echo "$XDG_CONFIG_HOME/lazygit"
    else
        echo "$HOME/.config/lazygit"
    fi
}

# Function to cache authentication for recent projects
cache_recent_projects_auth() {
    local config_dir
    config_dir=$(get_lazygit_config_dir)
    local state_file="$config_dir/state.yml"
    local has_errors=false
    
    echo -e "${BLUE}Caching authentication for recent lazygit projects...${NC}"
    
    if [[ ! -f "$state_file" ]]; then
        echo -e "${YELLOW}⚠ No lazygit state file found at $state_file${NC}"
        echo "Run lazygit at least once to generate recent projects list"
        echo -e "${RED}✗ Warning: Cannot cache authentication without recent projects${NC}"
        has_errors=true
    fi
    
    # Extract recent repo paths from lazygit state.yml
    local recent_repos
    if [[ "$has_errors" == "false" ]]; then
        if command -v yq >/dev/null 2>&1; then
            recent_repos=$(yq '.recentrepos[]' "$state_file" 2>/dev/null | head -20)
        else
            recent_repos=$(awk '/^recentrepos:/{flag=1;next} /^[a-zA-Z]/{flag=0} flag && /^[[:space:]]*-/ {gsub(/^[[:space:]]*-[[:space:]]*/, ""); print}' "$state_file" | head -20)
        fi
        
        if [[ -z "$recent_repos" ]]; then
            echo -e "${YELLOW}⚠ No recent repositories found in lazygit state${NC}"
            echo -e "${RED}✗ Warning: Cannot cache authentication - no recent repos${NC}"
            has_errors=true
        fi
    fi
    
    # Collect unique hosts from all repos
    declare -A unique_hosts
    
    if [[ "$has_errors" == "false" ]]; then
        while IFS= read -r repo_path; do
            if [[ -n "$repo_path" && -d "$repo_path" ]]; then
                # Change to repo directory and extract host info
                if cd "$repo_path" 2>/dev/null; then
                    if git rev-parse --git-dir >/dev/null 2>&1; then
                        # Get the remote URL and extract host
                        local remote_url
                        remote_url=$(git remote get-url origin 2>/dev/null || git remote get-url "$(git remote | head -1)" 2>/dev/null)
                        
                        if [[ -n "$remote_url" ]]; then
                            local host
                            # Extract host from various URL formats
                            if [[ "$remote_url" =~ ^https?://([^/]+) ]]; then
                                host="${BASH_REMATCH[1]}"
                            elif [[ "$remote_url" =~ ^git@([^:]+): ]]; then
                                host="${BASH_REMATCH[1]}"
                            elif [[ "$remote_url" =~ ^ssh://[^@]*@?([^/:]+) ]]; then
                                host="${BASH_REMATCH[1]}"
                            elif [[ "$remote_url" =~ ^git::@([^:]+): ]]; then
                                host="${BASH_REMATCH[1]}"
                            fi
                            
                            if [[ -n "$host" ]]; then
                                unique_hosts["$host"]=1
                            fi
                        fi
                    fi
                    # Return to original directory
                    cd - >/dev/null
                fi
            fi
        done <<< "$recent_repos"
        
        if [[ ${#unique_hosts[@]} -eq 0 ]]; then
            echo -e "${YELLOW}⚠ No git remotes found in recent repositories${NC}"
            echo -e "${RED}✗ Warning: Cannot cache authentication - no remotes found${NC}"
            has_errors=true
        fi
    fi
    
    # Cache authentication for each unique host
    if [[ "$has_errors" == "false" ]]; then
        for host in "${!unique_hosts[@]}"; do
            
            # Find a repo for this host to test authentication
            local test_repo=""
            while IFS= read -r repo_path; do
                if [[ -n "$repo_path" && -d "$repo_path" ]]; then
                    if cd "$repo_path" 2>/dev/null; then
                        if git rev-parse --git-dir >/dev/null 2>&1; then
                            local remote_url
                            remote_url=$(git remote get-url origin 2>/dev/null || git remote get-url "$(git remote | head -1)" 2>/dev/null)
                            
                            if [[ -n "$remote_url" ]]; then
                                local repo_host
                                if [[ "$remote_url" =~ ^https?://([^/]+) ]]; then
                                    repo_host="${BASH_REMATCH[1]}"
                                elif [[ "$remote_url" =~ ^git@([^:]+): ]]; then
                                    repo_host="${BASH_REMATCH[1]}"
                                elif [[ "$remote_url" =~ ^ssh://[^@]*@?([^/:]+) ]]; then
                                    repo_host="${BASH_REMATCH[1]}"
                                elif [[ "$remote_url" =~ ^git::@([^:]+): ]]; then
                                    repo_host="${BASH_REMATCH[1]}"
                                fi
                                
                                if [[ "$repo_host" == "$host" ]]; then
                                    test_repo="$repo_path"
                                    cd - >/dev/null
                                    break
                                fi
                            fi
                        fi
                        cd - >/dev/null
                    fi
                fi
            done <<< "$recent_repos"
            
            if [[ -n "$test_repo" ]]; then
                (
                    cd "$test_repo" || return 1
                    if git ls-remote >/dev/null 2>&1; then
                        echo -e "${GREEN}✓ Authentication cached for $host${NC}"
                    else
                        echo -e "${RED}✗ Warning: Could not cache authentication for $host${NC}"
                        has_errors=true
                    fi
                ) || has_errors=true
            else
                echo -e "${RED}✗ Warning: Could not find test repository for $host${NC}"
                has_errors=true
            fi
        done
    fi
    
    if [[ "$has_errors" == "true" ]]; then
        return 1
    else
        return 0
    fi
}

# Main logic
HAS_AUTH_ERRORS=false

if is_git_repo; then
    cache_current_repo_auth
else
    if ! cache_recent_projects_auth; then
        echo -e "${YELLOW}⚠ Proceeding to lazygit despite authentication caching issues${NC}"
        HAS_AUTH_ERRORS=true
    fi
fi

# Add delay if there were errors so user can see them
if [[ "$HAS_AUTH_ERRORS" == "true" && "$CACHE_ONLY" != "true" ]]; then
    echo -e "${BLUE}Waiting 3 seconds before launching lazygit...${NC}"
    sleep 3
fi

# Launch lazygit (unless cache-only mode)
if [[ "$CACHE_ONLY" == "true" ]]; then
    echo -e "${GREEN}✓ Cache-only mode complete${NC}"
else
    exec lazygit "$@"
fi