#!/usr/bin/env bash
# Copy PATH utilities from bin/ into ~/.local/bin (or override dest).
#
# Usage: ./install-bin [dest]
#   dest defaults to $HOME/.local/bin
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

usage() {
  cat <<'EOF' >&2
Usage: ./install-bin [dest]
  Copy executables from bin/ into dest (default: ~/.local/bin).
EOF
}

if [[ $# -gt 1 ]]; then
  usage
  exit 2
fi

DEST="${1:-$HOME/.local/bin}"
mkdir -p "$DEST"

shopt -s nullglob
for src in "$ROOT/bin"/*; do
  [[ -f "$src" && -x "$src" ]] || continue
  base="$(basename "$src")"
  install -m 755 "$src" "$DEST/$base"
  echo "install $DEST/$base"
done

echo "done -> $DEST"
